[Version]
Signature="$WINDOWS NT$"
Class=Display
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
DriverVer=10/18/2026,0.1.2.0

[Manufacturer]
%Provider%=Firecracker,NTx86.5.1,NTx86.5.2,NTx86.6.0

[Firecracker.NTx86.5.1]
%Display%=FcVbe,PCI\VEN_1234&DEV_1111&SUBSYS_11111234&REV_01

[Firecracker.NTx86.5.2]

[Firecracker.NTx86.6.0]

[DestinationDirs]
FcVbe.Files=12

[SourceDisksNames]
1=%DiskName%

[SourceDisksFiles]
fcvbe.sys=1

[FcVbe]
CopyFiles=FcVbe.Files

[FcVbe.Files]
fcvbe.sys

[FcVbe.SoftwareSettings]
AddReg=FcVbe.Settings

[FcVbe.Settings]
HKR,,InstalledDisplayDrivers,0x00010000,framebuf
HKR,,VgaCompatible,0x00010001,0

[FcVbe.Services]
AddService=fcvbe,0x00000002,FcVbe.Service,FcVbe.EventLog

[FcVbe.Service]
DisplayName=%ServiceName%
ServiceType=1
StartType=1
ErrorControl=1
LoadOrderGroup=Video
ServiceBinary=%12%\fcvbe.sys

[FcVbe.EventLog]
AddReg=FcVbe.EventLog.Settings

[FcVbe.EventLog.Settings]
HKR,,EventMessageFile,0x00020000,"%%SystemRoot%%\System32\IoLogMsg.dll"
HKR,,TypesSupported,0x00010001,7

[Strings]
Provider="Bloudraad"
Display="Firecracker linear display (XP x86 prototype)"
ServiceName="Firecracker XP linear display miniport"
DiskName="Firecracker XP x86 display prototype"
