diff --git a/OvmfPkg/CloudHv/Tests/LargeVariable.c b/OvmfPkg/CloudHv/Tests/LargeVariable.c
new file mode 100644
--- /dev/null
+++ b/OvmfPkg/CloudHv/Tests/LargeVariable.c
@@ -0,0 +1,69 @@
+// Copyright 2026 Bloudraad.
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#include <Uefi.h>
+#include <Guid/ImageAuthentication.h>
+#include <Library/BaseCryptLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/PrintLib.h>
+#include <Library/SerialPortLib.h>
+#include <Library/UefiLib.h>
+#include <Library/UefiRuntimeServicesTableLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include "LargeVariable.h"
+
+VOID Report (CONST CHAR8 *Name, UINT64 Value) {
+  CHAR8 Line[128];
+  UINTN Length = AsciiSPrint (Line, sizeof (Line), "SECURE-PROBE %a=%Lx\r\n", Name, Value);
+  SerialPortWrite ((UINT8 *)Line, Length);
+  if (gST->ConOut != NULL) { Print (L"%a", Line); }
+}
+BOOLEAN LargeDbx (VOID) {
+  STATIC CONST UINT8 Header[28] = {
+    0x26,0x16,0xc4,0xc1,0x4c,0x50,0x92,0x40,0xac,0xa9,0x41,0xf9,0x36,0x93,0x43,0x28,
+    0x9c,0x06,1,0, 0,0,0,0, 48,0,0,0
+  };
+  STATIC CONST UINT8 ExpectedDigest[SHA256_DIGEST_SIZE] = {
+    0x60,0xfa,0xcb,0xb0,0xd3,0x2a,0xba,0x50,
+    0xaa,0xe0,0xc5,0xe6,0x71,0xa3,0xd8,0x74,
+    0xdf,0x0c,0xb9,0x2b,0xd7,0x15,0x9e,0xd0,
+    0xd1,0xc4,0xd6,0x4e,0xe3,0x2a,0xbe,0xe0
+  };
+  UINTN Size = 0;
+  UINT32 Attributes = 0;
+  EFI_STATUS Status = gRT->GetVariable (L"dbx", &gEfiImageSecurityDatabaseGuid, &Attributes, &Size, NULL);
+  Report ("dbx-query-status", Status); Report ("dbx-query-size", Size);
+  if (Status != EFI_BUFFER_TOO_SMALL || Size != 67228) { Report ("dbx-valid", 0); return FALSE; }
+  UINT8 *Data = AllocatePool (Size);
+  UINT8 *Expected = AllocateZeroPool (Size);
+  if (Data == NULL || Expected == NULL) {
+    if (Data != NULL) { FreePool (Data); }
+    if (Expected != NULL) { FreePool (Expected); }
+    Report ("dbx-allocation-failed", 1); Report ("dbx-valid", 0); return FALSE;
+  }
+  Status = gRT->GetVariable (L"dbx", &gEfiImageSecurityDatabaseGuid, &Attributes, &Size, Data);
+  Report ("dbx-read-status", Status); Report ("dbx-read-size", Size); Report ("dbx-attributes", Attributes);
+  CopyMem (Expected, Header, sizeof (Header));
+  for (UINT32 Index = 0; Index < 1400; Index++) { CopyMem (Expected + 28 + Index * 48 + 16, &Index, sizeof (Index)); }
+  BOOLEAN BytesMatch = !EFI_ERROR (Status) && Size == 67228 && CompareMem (Data, Expected, Size) == 0;
+  UINT8 Digest[SHA256_DIGEST_SIZE];
+  BOOLEAN HasDigest = !EFI_ERROR (Status) && Size == 67228 && Sha256HashAll (Data, Size, Digest);
+  BOOLEAN HashMatch = HasDigest && CompareMem (Digest, ExpectedDigest, sizeof (Digest)) == 0;
+  if (HasDigest) {
+    CHAR8 Hex[SHA256_DIGEST_SIZE * 2 + 1];
+    CHAR8 Line[128];
+    for (UINTN Index = 0; Index < sizeof (Digest); Index++) {
+      Hex[Index * 2] = "0123456789abcdef"[Digest[Index] >> 4];
+      Hex[Index * 2 + 1] = "0123456789abcdef"[Digest[Index] & 15];
+    }
+    Hex[sizeof (Hex) - 1] = 0;
+    UINTN Length = AsciiSPrint (Line, sizeof (Line), "SECURE-PROBE dbx-sha256=%a\r\n", Hex);
+    SerialPortWrite ((UINT8 *)Line, Length);
+    if (gST->ConOut != NULL) { Print (L"%a", Line); }
+  }
+  Report ("dbx-bytes-match", BytesMatch); Report ("dbx-sha256-match", HashMatch);
+  BOOLEAN Valid = BytesMatch && HashMatch && Attributes == 0x27;
+  Report ("dbx-valid", Valid);
+  FreePool (Expected); FreePool (Data);
+  return Valid;
+}
