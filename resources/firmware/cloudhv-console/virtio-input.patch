+STATIC
+EFI_STATUS
+VirtioInputSendLeds (
+  IN OUT VIRTIO_INPUT_DEV  *Dev
+  )
+{
+  VIRTIO_INPUT_RING         *Ring;
+  VIRTIO_INPUT_EVENT        Event;
+  volatile VRING_USED_ELEM  *Used;
+  UINT16                   Completed;
+  UINT16                   Index;
+  UINT16                   Code;
+  UINT16                   Slot;
+  EFI_STATUS               Status;
+
+  Ring = &Dev->Rings[1];
+  if (!Ring->Ready) {
+    return EFI_NOT_READY;
+  }
+
+  Completed = (UINT16)(*Ring->Ring.Used.Idx - Ring->LastUsedIdx);
+  MemoryFence ();
+  if (Completed > 3) {
+    return EFI_DEVICE_ERROR;
+  }
+  for (Index = 0; Index < Completed; Index++) {
+    Used = &Ring->Ring.Used.UsedElem[Ring->LastUsedIdx % Ring->Ring.QueueSize];
+    if ((Used->Id >= 3) || (Used->Id >= Ring->Ring.QueueSize) ||
+        ((Dev->StatusOwned & (1U << Used->Id)) == 0) ||
+        (Used->Len > Ring->BufferSize)) {
+      return EFI_DEVICE_ERROR;
+    }
+    Dev->StatusOwned &= (UINT8)~(1U << Used->Id);
+    Ring->LastUsedIdx++;
+  }
+
+  for (Code = LED_NUML; Code <= LED_SCROLLL; Code++) {
+    if ((Dev->PendingLeds & (1U << Code)) == 0) {
+      continue;
+    }
+    for (Slot = 0; (Slot < 3) && (Slot < Ring->Ring.QueueSize); Slot++) {
+      if ((Dev->StatusOwned & (1U << Slot)) == 0) {
+        break;
+      }
+    }
+    if ((Slot == 3) || (Slot == Ring->Ring.QueueSize)) {
+      break;
+    }
+    Event.Type  = EV_LED;
+    Event.Code  = Code;
+    Event.Value = (Code == LED_NUML) ? Dev->NumLock :
+                  ((Code == LED_CAPSL) ? Dev->CapsLock : Dev->ScrollLock);
+    Ring->Indices.HeadDescIdx = Slot;
+    Ring->Indices.NextDescIdx = Slot;
+    Status = VirtioInputRingSendBuffer (Dev, 1, &Event, sizeof (Event), FALSE);
+    if (EFI_ERROR (Status)) {
+      return Status;
+    }
+    Dev->StatusOwned |= (UINT8)(1U << Slot);
+    Dev->PendingLeds &= (UINT8)~(1U << Code);
+  }
+
+  if (Dev->StatusOwned != 0) {
+    return Dev->VirtIo->SetQueueNotify (Dev->VirtIo, 1);
+  }
+  return EFI_SUCCESS;
+}
+
+EFI_STATUS
+VirtioInputUpdateLeds (
+  IN OUT VIRTIO_INPUT_DEV  *Dev,
+  IN UINT8                Changed
+  )
+{
+  Dev->PendingLeds |= Changed;
+  return VirtioInputSendLeds (Dev);
 }

